# Same names Vercel imports from the Supabase integration.
# Copy to .env.local and fill in values from Supabase → Project Settings → API
# (or rely on Vercel env vars in production).
#
# npm start / npm run build map these to REACT_APP_* automatically
# (Create React App only exposes REACT_APP_* to the browser).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Do not add SUPABASE_SERVICE_ROLE_KEY here. It bypasses row-level security
# and must never ship in a frontend bundle.

# Free key from https://www.omdbapi.com/apikey.aspx — used by the admin page
# to look up movie/TV posters and season counts. Not required for anime/manga
# (Jikan needs no key). Without it, OMDB lookups are simply disabled.
OMDB_API_KEY=YOUR_OMDB_API_KEY
